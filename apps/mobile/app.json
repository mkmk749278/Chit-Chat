{
  "expo": {
    "name": "Lumin Chat",
    "slug": "chat-app",
    "version": "0.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Lumin Chat needs access to your photos so you can send them in an end-to-end encrypted chat."
      }
    },
    "android": {
      "package": "com.chatapp.mobile",
      "permissions": [],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-notifications"
    ],
    "newArchEnabled": true
  }
}
