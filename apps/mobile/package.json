{
  "name": "@chat-app/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile client (React Native / Expo) — skeleton only in Phase 0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist/crypto/*.test.js dist/ui/*.test.js dist/app/*.test.js dist/data/*.test.js dist/push/*.test.js"
  },
  "dependencies": {
    "@chat-app/crypto": "0.0.0",
    "@chat-app/types": "0.0.0",
    "@expo/vector-icons": "^14.0.0",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/app": "^20.5.0",
    "@react-native-firebase/auth": "^20.5.0",
    "@react-native-firebase/messaging": "^20.5.0",
    "buffer": "^6.0.3",
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.0",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-image-picker": "^7.2.3",
    "react-native-quick-base64": "^2.1.2",
    "react-native-quick-crypto": "^0.7.6",
    "react-native-safe-area-context": "4.10.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
